<UserControl
          x:Class="SillyMIDI.Core.Views.LargeView.BottomPlayerView"
          xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:acrylic="using:Fluid.Avalonia.Acrylic"
          xmlns:acrylicblur="using:Artemis.UI.Controls.AcrylicBlur"
          xmlns:asyncImageLoader="using:AsyncImageLoader"
          xmlns:core="using:SillyMIDI.Core"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:ic="https://github.com/MahApps/IconPacks.Avalonia"
          xmlns:local="using:SillyMIDI.Core.Controls"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:usercontrols="using:Drizzle.UI.Avalonia.UserControls"
          xmlns:viewmodels="clr-namespace:SillyMIDI.Core.ViewModels"
          d:DesignHeight="450"
          d:DesignWidth="800"
          x:DataType="viewmodels:Players.MiniPlayerViewModel"
          mc:Ignorable="d">
    <acrylic:AcrylicSurface
              BlurRadius="8"
              HighlightEnabled="False"
              TintColor="Black"
              Vibrancy="1.5">


        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <!--  Track info  -->
                <ColumnDefinition Width="325" />

                <!--  progress bar & control  -->
                <ColumnDefinition Width="*" MinWidth="250" />

                <!--  aux info  -->
                <ColumnDefinition Width="Auto" />

            </Grid.ColumnDefinitions>

            <!--  now playing  -->
            <StackPanel
                      Grid.Column="0"
                      Margin="10,0,0,0"
                      HorizontalAlignment="Stretch"
                      ClipToBounds="True"
                      Orientation="Horizontal">
                <asyncImageLoader:AdvancedImage
                          Grid.Column="0"
                          Width="70"
                          Height="70"
                          VerticalAlignment="Top"
                          Loader="{x:Static core:App.ImageLoaderInstance}"
                          Source="{Binding Path=PlayersService.SelectedPlayer.CurrentMedia.ImageUrl}">
                    <Interaction.Behaviors>
                        <EventTriggerBehavior EventName="Tapped">
                            <InvokeCommandAction Command="{Binding ClickedCommand}" />
                        </EventTriggerBehavior>
                    </Interaction.Behaviors>
                </asyncImageLoader:AdvancedImage>

                <StackPanel Margin="15,5,5,5">
                    <TextBlock FontSize="14" Text="{Binding PlayersService.SelectedPlayer.CurrentMedia.Artist}" />
                    <TextBlock FontWeight="Bold" Text="{Binding PlayersService.SelectedPlayer.CurrentMedia.Title}" />
                    <TextBlock FontSize="12" Text="{Binding PlayersService.SelectedPlayer.Name}" />
                </StackPanel>
            </StackPanel>

            <!--  Progress bar and controls  -->
            <StackPanel Grid.Column="1">
                <StackPanel
                          Margin="0,-5,0,5"
                          HorizontalAlignment="Center"
                          Orientation="Horizontal">
                    <Button
                              Margin="3,0,3,0"
                              Classes="iconButton navButton"
                              Command="{Binding PlayPreviousCommand}">
                        <ic:PackIconMaterial
                                  Width="25"
                                  Height="16"
                                  Kind="SkipPrevious" />
                    </Button>
                    <Button
                              Margin="3,0,3,0"
                              Classes="iconButton navButton"
                              Command="{Binding PlayerPlayPauseCommand}">
                        <ic:PackIconMaterial
                                  Width="25"
                                  Height="22"
                                  Kind="{Binding PlayersService.SelectedPlayer.PlaybackState, Converter={StaticResource PlaybackStateToIconConverter}, FallbackValue={x:Static ic:PackIconMaterialKind.Play}}" />
                    </Button>
                    <Button
                              Margin="3,0,20,0"
                              Classes="iconButton navButton"
                              Command="{Binding PlayerNextCommand}">
                        <ic:PackIconMaterial
                                  Width="25"
                                  Height="16"
                                  Kind="SkipNext" />
                    </Button>
                </StackPanel>
                <Grid MaxWidth="600" Margin="10,5,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                              Grid.Column="0"
                              Margin="0,5,10,0"
                              FontSize="14"
                              Text="{Binding PlayersService.SelectedQueue.CurrentItem.MediaItem.ElapsedTime, Converter={StaticResource FriendlyTimeConverter}}" />

                    <local:WaveformProgressBar
                              Grid.Column="1"
                              Height="30"
                              Peaks="{Binding Waveforms}"
                              PlayedBrush="#FFFFFF"
                              Progress="{Binding PlayersService.Progress, Mode=TwoWay}"
                              Resolution="1"
                              UnplayedBrush="#555555" />

                    <TextBlock
                              Grid.Column="2"
                              Margin="10,5,0,0"
                              FontSize="14"
                              Text="{Binding PlayersService.SelectedQueue.CurrentItem.MediaItem.Duration, Converter={StaticResource FriendlyTimeConverter}}" />
                </Grid>

            </StackPanel>

            <!--  aux info  -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Classes="iconButton navButton" Command="{Binding PlayerNextCommand}">
                    <ic:PackIconMaterial
                              Width="25"
                              Height="15"
                              Kind="Speaker" />
                </Button>
                <Button Classes="iconButton navButton" Command="{Binding PlayerNextCommand}">
                    <ic:PackIconMaterial
                              Width="25"
                              Height="15"
                              Kind="SpeakerMultiple" />
                </Button>
                <Button Classes="iconButton navButton" Command="{Binding PlayerNextCommand}">
                    <ic:PackIconMaterial
                              Width="25"
                              Height="15"
                              Kind="VolumeSource" />
                </Button>
            </StackPanel>
        </Grid>
        <!--  your content  -->
    </acrylic:AcrylicSurface>
</UserControl>
