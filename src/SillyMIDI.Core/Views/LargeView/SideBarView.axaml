<UserControl
          x:Class="SillyMIDI.Core.Views.LargeView.SideBarView"
          xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:largeview="using:SillyMIDI.Core.ViewModels.LargeView"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          d:DesignHeight="450"
          d:DesignWidth="800"
          x:DataType="largeview:SidebarViewModel"
          Background="#FF2B2B2B"
          mc:Ignorable="d">
    <Grid Margin="5,5,5,0">
        <Image
                  Width="30"
                  Height="30"
                  Margin="20"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Source="avares://SillyMIDI.Core/Assets/logo.png" />
        <ListBox
                  Margin="0,50,0,0"
                  Background="{x:Null}"
                  ItemsSource="{Binding Items}" />
    </Grid>
</UserControl>
